{
  "name": "mobilestock/scribe-tdd",
  "description": "scribe-tdd is a library that extends ajcastro-scribe-tdd. It includes internal adjustments to ensure compatibility with PHPUnit 11.4 and PEST.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "MobileStock",
      "email": "fabio@mobilestock.com.br"
    }
  ],
  "require": {
    "knuckleswtf/scribe": "^5.2",
    "spatie/laravel-data": "^4.20"
  },
  "require-dev": {
    "pestphp/pest": "^3.0",
    "orchestra/testbench": "^9.5"
  },
  "autoload": {
    "psr-4": {
      "AjCastro\\ScribeTdd\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "AjCastro\\ScribeTdd\\ScribeTddServiceProvider"
      ]
    }
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
